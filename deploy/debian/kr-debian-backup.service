[Unit]
Description=Back up the KR-Debian PostgreSQL database
Requires=postgresql@18-main.service
After=postgresql@18-main.service

[Service]
Type=oneshot
User=kr-debian
Group=kr-debian
StateDirectory=kr-debian-backups
StateDirectoryMode=0700
EnvironmentFile=/etc/kr-debian/database.env
ExecStart=/opt/kr-debian/current/bin/backup
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
